{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/build_webgl/$1" }
  ],
  "headers": [
    {
      "source": "/build_webgl/Build/(.*).wasm.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
      "source": "/build_webgl/Build/(.*).js.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/build_webgl/Build/(.*).data.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ]
}
